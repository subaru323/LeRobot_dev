# Starts the easy_lerobot screen when the Raspberry Pi boots. See deploy/README.md.
# Paths assume user "lerobot", the repository in ~/LeRobot_dev and a venv in ~/venv;
# edit User, WorkingDirectory and ExecStart if yours differ.
[Unit]
Description=easy_lerobot web app
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lerobot
# dialout: serial ports of the servo boards, video: cameras
SupplementaryGroups=dialout video
WorkingDirectory=/home/lerobot/LeRobot_dev/easy_lerobot
# Ports of the leader and follower (optional file; defaults are /dev/ttyACM0 and /dev/ttyACM1)
EnvironmentFile=-/home/lerobot/LeRobot_dev/easy_lerobot/deploy/easy-lerobot.env
ExecStart=/home/lerobot/venv/bin/python -m streamlit run app.py
Restart=on-failure
RestartSec=3
# Stop only the screen; a running mirror keeps its ports until it is stopped from the screen,
# which finds it again through the state files in core/procs.py.
KillMode=process
# The screen never needs more rights than the user it runs as.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
