# Copy to easy-lerobot.env (not committed). Use the names under /dev/serial/by-id/:
# unlike /dev/ttyACM0 and /dev/ttyACM1 they do not swap with the plug order.
EASY_LEROBOT_LEADER_PORT=/dev/serial/by-id/usb-REPLACE_WITH_LEADER_BOARD-if00
EASY_LEROBOT_FOLLOWER_PORT=/dev/serial/by-id/usb-REPLACE_WITH_FOLLOWER_BOARD-if00
