<mxfile host="app.diagrams.net" type="device"><diagram id="全体像" name="全体像"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="全体-1" value="LeRobot 全体像（ホワイトボードの清書）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Meiryo;fontSize=12;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="全体-2" value="2" style="rounded=0;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="500" height="200" as="geometry"/></mxCell><mxCell id="全体-3" value="1" style="rounded=0;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="500" height="460" as="geometry"/></mxCell><mxCell id="全体-4" value="素人" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="40" height="80" as="geometry"/></mxCell><mxCell id="全体-5" value="&lt;b&gt;Web アプリ&lt;/b&gt;&lt;br&gt;※誰でも使えるように作る&lt;br&gt;・開発&lt;br&gt;&lt;br&gt;担当：？・米澤" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="95" width="280" height="130" as="geometry"/></mxCell><mxCell id="全体-6" value="操作" style="html=1;startArrow=block;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Meiryo;fontSize=12;" edge="1" parent="1" source="全体-4" target="全体-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="全体-7" value="&lt;b&gt;ソースコード&lt;/b&gt;&lt;br&gt;・学習 …… 米澤・？・山本&lt;br&gt;・制御 …… 米澤・ヒム？&lt;br&gt;・AI 推論 …… シイン？&lt;br&gt;&lt;br&gt;テスト環境が必要" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="340" height="170" as="geometry"/></mxCell><mxCell id="全体-8" value="どうつなぐ？" style="html=1;startArrow=block;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Meiryo;fontSize=12;" edge="1" parent="1" source="全体-5" target="全体-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="全体-9" value="カメラ 1（上から）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Meiryo;fontSize=12;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="170" height="40" as="geometry"/></mxCell><mxCell id="全体-10" value="カメラ 2（手先）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Meiryo;fontSize=12;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="170" height="40" as="geometry"/></mxCell><mxCell id="全体-11" value="カメラ映像" style="html=1;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Meiryo;fontSize=12;" edge="1" parent="1" source="全体-9" target="全体-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="全体-12" value="カメラ映像" style="html=1;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Meiryo;fontSize=12;" edge="1" parent="1" source="全体-10" target="全体-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="全体-13" value="組み立て ＋ 3D プリンター　担当：山本・東" style="rounded=0;dashed=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="450" height="160" as="geometry"/></mxCell><mxCell id="全体-14" value="アーム&#xa;（フォロワー）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Meiryo;fontSize=12;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="345" y="620" width="140" height="80" as="geometry"/></mxCell><mxCell id="全体-15" value="リーダー&#xa;（コントローラー・手で動かす）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Meiryo;fontSize=12;align=center;verticalAlign=middle;spacingLeft=0;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="590" y="620" width="180" height="80" as="geometry"/></mxCell><mxCell id="全体-16" value="動かす指令 ／ モーターの位置" style="html=1;startArrow=block;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Meiryo;fontSize=12;" edge="1" parent="1" source="全体-7" target="全体-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="全体-17" value="手の動きをまねる" style="html=1;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Meiryo;fontSize=12;dashed=1;" edge="1" parent="1" source="全体-15" target="全体-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="全体-18" value="「どうつなぐ？」への案&#xa;Web アプリ（Streamlit）が Runner 経由で lerobot-* コマンドを起動する。進み具合は project.json とログで受け渡す（配置図・シーケンス図を参照）。" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="120" width="300" height="120" as="geometry"/></mxCell><mxCell id="全体-19" value="中間目標（スケジュール）&#xa;・モーターの制御&#xa;・ソースコードがしっかり動くかテストする！！" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="全体-20" value="担当者名はホワイトボードからの読み取りです。「？」は判読が不確かな箇所なので、正しい名前に直してください。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Meiryo;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="440" width="300" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="配置図" name="配置図"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="配置-1" value="配置図：学習は GPU の PC、それ以外はラズパイで完結させる" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Meiryo;fontSize=12;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="配置-2" value="«device»&#xa;利用者の PC / タブレット" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="220" height="130" as="geometry"/></mxCell><mxCell id="配置-3" value="«artifact»&#xa;Web ブラウザ" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="配置-2"><mxGeometry x="20" y="55" width="180" height="50" as="geometry"/></mxCell><mxCell id="配置-4" value="«device»&#xa;Raspberry Pi 5（8GB 想定）&#xa;«execution environment» Linux / easy_lerobot の .venv" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="420" height="400" as="geometry"/></mxCell><mxCell id="配置-5" value="Streamlit アプリ&#xa;（5 画面）" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="配置-4"><mxGeometry x="20" y="75" width="180" height="55" as="geometry"/></mxCell><mxCell id="配置-6" value="core&#xa;Project / Runner / Step" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="配置-4"><mxGeometry x="220" y="75" width="180" height="55" as="geometry"/></mxCell><mxCell id="配置-7" value="lerobot-* コマンド&#xa;find-port / calibrate /&#xa;record / rollout" style="shape=component;align=left;spacingLeft=36;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="配置-4"><mxGeometry x="220" y="160" width="180" height="75" as="geometry"/></mxCell><mxCell id="配置-8" value="«artifact»&#xa;projects/〈名前〉/&#xa;project.json・logs・run.json" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="配置-4"><mxGeometry x="20" y="160" width="180" height="75" as="geometry"/></mxCell><mxCell id="配置-9" value="«artifact»&#xa;学習済みモデル（ダウンロード済み）" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="配置-4"><mxGeometry x="220" y="265" width="180" height="55" as="geometry"/></mxCell><mxCell id="配置-10" value="pty（仮想端末）経由で起動し、Enter・矢印キー・Esc を送る" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Meiryo;fontSize=12;fontSize=11;" vertex="1" parent="配置-4"><mxGeometry x="20" y="265" width="180" height="70" as="geometry"/></mxCell><mxCell id="配置-11" value="«device»&#xa;SO-101 フォロワー" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="540" width="150" height="70" as="geometry"/></mxCell><mxCell id="配置-12" value="«device»&#xa;SO-101 リーダー" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;verticalAlign=top;align=left;spacingLeft=8;container=1;collapsible=0;fontFamily=Meiryo;fontSize=12;" vertex="1" parent="1"><mxGeometry x="